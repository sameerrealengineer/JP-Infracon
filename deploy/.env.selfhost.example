# Copy to deploy/.env and fill in. Never commit the real file.
# Your free domain, e.g. jpinfracon.duckdns.org (DuckDNS) pointing to the server's public IP.
DOMAIN=jpinfracon.duckdns.org

# Long random values (use: openssl rand -hex 24)
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
# One-time key to create the first Super Admin from the app. Keep it secret.
JP_SUPERADMIN_BOOTSTRAP_SECRET=

# Optional — AI (keys stay on the server)
GEMINI_API_KEY=
SARVAM_API_KEY=

# Optional — alerts (see .env.example in the repo root for all choices)
WHATSAPP_PROVIDER=
WAHA_URL=http://waha:3000
WAHA_API_KEY=
SMS_PROVIDER=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
