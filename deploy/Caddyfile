{$DOMAIN} {
	encode gzip

	# The API and its file links go to the Node server.
	@server path /api/* /manus-storage/*
	handle @server {
		reverse_proxy api:3000
	}

	# Everything else is the web app (for iPhone and computers), built by scripts/deploy-web.sh.
	handle {
		root * /srv/web
		@assets path /_expo/* /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /_expo/* /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}
