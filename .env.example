# JP Infracon API — environment variables. Copy to .env on the server; never commit real values.

# --- Core ---
DATABASE_URL=mysql://user:password@host:3306/jp_infracon
JWT_SECRET=
# One-time first Super Admin setup key (keep secret; not needed after setup).
JP_SUPERADMIN_BOOTSTRAP_SECRET=
# File storage (private evidence photos/PDFs).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Push notifications (Expo push service, free) ---
# Optional: enables "enhanced push security" on your Expo account.
EXPO_ACCESS_TOKEN=

# --- WhatsApp alerts: pick ONE provider ---
# openwa     = OpenWA, open source (MIT), self-hosted Docker (github.com/rmyndharis/OpenWA)
# waha       = WAHA, open source, self-hosted Docker (github.com/devlikeapro/waha)
# evolution  = Evolution API, open source, self-hosted (github.com/EvolutionAPI/evolution-api)
# cloud      = official WhatsApp Business Cloud API from Meta (no ban risk; template rules apply)
WHATSAPP_PROVIDER=
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
# OPENWA_SESSION is the session id (UUID) shown in the OpenWA dashboard
OPENWA_SESSION=
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=

# --- SMS alerts (urgent only): pick ONE provider ---
# android-sms-gateway = SMS Gateway for Android, open source (github.com/capcom6/android-sms-gateway)
# textbee             = textbee, open source (github.com/vernu/textbee)
SMS_PROVIDER=
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
TEXTBEE_URL=https://api.textbee.dev/api/v1
TEXTBEE_DEVICE_ID=
TEXTBEE_API_KEY=

# --- AI assistants (server-side only; keys never go into the APK) ---
# Gemini API key from https://aistudio.google.com (a Gemini app subscription is not an API key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Sarvam AI key from https://dashboard.sarvam.ai (speech-to-text in Odia/Hindi, translation).
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
